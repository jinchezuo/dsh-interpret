{
  "name": "dsh-interpret",
  "version": "1.1.1",
  "description": "DSH 实时英中同传字幕插件：麦克风/系统音频 → 本地 ASR → 术语化翻译 → 双语字幕，内置讲义阅读器",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinchezuo/dsh-interpret.git"
  },
  "homepage": "https://github.com/jinchezuo/dsh-interpret#readme",
  "bugs": {
    "url": "https://github.com/jinchezuo/dsh-interpret/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "interpretation",
    "translation",
    "subtitles",
    "parakeet",
    "sherpa-onnx",
    "handout-reader"
  ],
  "author": "dsh-interpret contributors",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "./src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "dev": "node scripts/build-client.mjs --watch",
    "test": "node --test test/*.test.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "build:win-audio": "powershell -ExecutionPolicy Bypass -File scripts/build-win-audio.ps1",
    "check-docs": "node scripts/check-docs.mjs",
    "prepack": "node scripts/clean-python-cache.mjs",
    "verify-python": "node scripts/verify-python-assets.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "files": [
    "src/host",
    "src/client",
    "src/win-audio/Program.cs",
    "src/win-audio/DshInterpret.AudioCapture.csproj",
    "lib",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CITATION.cff",
    "docs"
  ],
  "dependencies": {
    "sherpa-onnx-node": "^1.13.6",
    "word-extractor": "1.0.4"
  }
}
